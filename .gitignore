# ==============================================================================
# HealthMesh — Root .gitignore
# ==============================================================================

# --- Environment & Sensitive Credentials ---
.env
.env.*
*.env
!.env.example
!backend/.env.example
*.pem
*.key
*.cert

# --- Dependencies ---
node_modules/
jspm_packages/
.pnp
.pnp.js

# --- Build & Compiled Outputs ---
dist/
dist-ssr/
build/
out/
.vite/
*.tsbuildinfo

# --- Runtime Uploads & Dynamic User Media ---
backend/uploads/*
!backend/uploads/.gitkeep
backend/uploads/hospitals/*
!backend/uploads/hospitals/.gitkeep

# --- Debug & Logs ---
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# --- Testing & Coverage ---
coverage/
.nyc_output/

# --- Operating System Files ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# --- IDEs & Code Editors ---
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json

# --- AI Agents & Local Tooling State ---
.agents/
.claude/
agent/
skills-lock.json
.cortex/
